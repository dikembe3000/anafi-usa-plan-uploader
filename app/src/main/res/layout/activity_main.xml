<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:id="@+id/connectionStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Looking for ANAFI USA…" android:textStyle="bold" />
        <TextView android:id="@+id/planStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="No plan selected" />
        <Button android:id="@+id/selectButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Choose MAVLink File" />
        <Button android:id="@+id/uploadButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:enabled="false" android:text="Upload to Drone" />
        <Button android:id="@+id/startButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:enabled="false" android:text="Start Flight Plan" />
        <Button android:id="@+id/stopButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:enabled="false" android:text="Stop Flight Plan" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="The app never starts a newly uploaded plan automatically. GPS, calibration, battery, and flight readiness must be confirmed before Start becomes available." />
    </LinearLayout>
</ScrollView>
