<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <ScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <TextView android:id="@+id/connectionStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Looking for ANAFI USA…" android:textStyle="bold" />
            <TextView android:id="@+id/selectionStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="No MAVLink plan selected" />
            <TextView android:id="@+id/planStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Waiting for the FlightPlan interface" />
            <Button android:id="@+id/selectButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Choose MAVLink File" />
            <Button android:id="@+id/uploadButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:enabled="false" android:text="Upload to Drone" />
            <Button android:id="@+id/startButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:enabled="false" android:text="Start Flight Plan" />
            <Button android:id="@+id/stopButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:enabled="false" android:text="Stop Flight Plan" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Blue dot: this phone. Purple route: selected MAVLink plan. Satellite imagery requires an internet connection." />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
